Menu="Docker:2"
Title="Batch Update"
Tag="cloud-download"
Cond="is_file('/var/run/dockerd.pid')"
Markdown="false"
---
<?PHP
/* Docker Batch Update
 *
 * Select any number of containers and update them one after another using the
 * stock Unraid update routine (update_container). This page only renders and
 * polls; see javascript/batch.js for the behaviour and include/ContainerList.php
 * for the data.
 *
 * Colours come from Unraid's own theme variables (7.1 and newer). For 7.0 the
 * stylesheet carries fallbacks keyed by the data-theme attribute below, which
 * is derived from the display theme the same way the stock webGUI does.
 */
$dbuTheme = strtolower(trim((string)($display['theme'] ?? '')));
$dbuTheme = strtok($dbuTheme, '-') ?: 'black';
if ($dbuTheme === 'grey') $dbuTheme = 'gray';
if (!in_array($dbuTheme, ['black', 'white', 'azure', 'gray'], true)) $dbuTheme = 'black';
?>
<link type="text/css" rel="stylesheet" href="<?autov('/plugins/docker.batch.update/sheets/batch.css')?>">

<div id="dbu" class="dbu" data-theme="<?=htmlspecialchars($dbuTheme)?>">

  <div class="dbu-head">
    <div class="dbu-head-copy">
      <h3 class="dbu-title"><i class="fa fa-cloud-download"></i>_(Batch Update)_</h3>
      <p class="dbu-desc">_(Tick the containers you want to update. They are updated one after another with Unraid's own update routine, in the order shown, and you can change that order in the confirmation step)_.</p>
    </div>
    <div class="dbu-toolbar">
      <input type="button" id="dbu-check" value="_(Check for Updates)_">
    </div>
  </div>

  <div class="dbu-cards">
    <div class="dbu-card" id="dbu-card-available" data-tone="neutral">
      <div class="dbu-card-label">_(Updates available)_</div>
      <div class="dbu-card-value">&ndash;</div>
      <div class="dbu-card-sub"></div>
    </div>
    <div class="dbu-card" id="dbu-card-selected" data-tone="neutral">
      <div class="dbu-card-label">_(Selected)_</div>
      <div class="dbu-card-value">0</div>
      <div class="dbu-card-sub"></div>
    </div>
    <div class="dbu-card" id="dbu-card-checked" data-tone="neutral">
      <div class="dbu-card-label">_(Last check)_</div>
      <div class="dbu-card-value">&ndash;</div>
      <div class="dbu-card-sub"></div>
    </div>
    <div class="dbu-card" id="dbu-card-updater" data-tone="neutral">
      <div class="dbu-card-label">_(Updater)_</div>
      <div class="dbu-card-value">&ndash;</div>
      <div class="dbu-card-sub"></div>
    </div>
  </div>

  <div id="dbu-result" class="dbu-result dbu-hidden"></div>

  <div class="dbu-filters">
    <div class="dbu-chips" role="group">
      <button type="button" class="dbu-chip" data-view="available" aria-pressed="false">_(Updates available)_ <span class="dbu-chip-n"></span></button>
      <button type="button" class="dbu-chip" data-view="all" aria-pressed="false">_(All)_ <span class="dbu-chip-n"></span></button>
      <button type="button" class="dbu-chip" data-view="running" aria-pressed="false">_(Running)_ <span class="dbu-chip-n"></span></button>
    </div>
    <label class="dbu-search"><i class="fa fa-search"></i><input type="search" id="dbu-search" placeholder="_(Filter by name or image)_" autocomplete="off" spellcheck="false"></label>
  </div>

  <div class="TableContainer--no-min-width" id="dbu-tablewrap">
    <table class="dbu-table" id="dbu-table">
      <thead>
        <tr>
          <th class="dbu-check"><input type="checkbox" id="dbu-checkall" title="_(Select all shown)_"></th>
          <th class="dbu-order">#</th>
          <th>_(Container)_</th>
          <th class="dbu-image">_(Image)_</th>
          <th>_(Update)_</th>
          <th>_(State)_</th>
          <th class="dbu-digest">_(Local)_ &rarr; _(Remote)_</th>
        </tr>
      </thead>
      <tbody id="dbu-list"><tr><td colspan="7" class="dbu-loading"><i class="fa fa-spinner fa-spin"></i> _(Loading)_...</td></tr></tbody>
    </table>
  </div>
  <div id="dbu-empty" class="dbu-empty dbu-hidden"></div>

  <div class="dbu-actions">
    <div class="dbu-actions-info" id="dbu-summary"></div>
    <div class="dbu-actions-buttons">
      <a id="dbu-clear" class="dbu-link dbu-hidden">_(Clear selection)_</a>
      <input type="button" id="dbu-update" value="_(Update Selected)_" disabled>
    </div>
  </div>
</div>

<script>
var dbuText = {
