<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "docker.batch.update">
<!ENTITY author    "tabilzad">
<!ENTITY version   "2026.11.03">
<!ENTITY md5       "9df3000496748db401b00a08bf467b62">
<!ENTITY launch    "Docker">
<!ENTITY repo      "tabilzad/unraid-docker-batch-update">
<!ENTITY branch    "main">
<!ENTITY gitURL    "https://raw.githubusercontent.com/&repo;/&branch;">
<!ENTITY pluginURL "&gitURL;/plugin/&name;.plg">
<!ENTITY pkgName   "&name;-&version;-noarch-1">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        support="https://forums.unraid.net/topic/200997-plugin-docker-batch-update-update-only-the-containers-you-pick-in-one-go/"
        icon="&name;.png"
        min="7.0.0">

<CHANGES>
###2026.11.03
- Fix: the Batch Update tab was missing after updating to 2026.11.02. That package was built from a Windows checkout and its files had CRLF line endings, which the webGUI page loader does not accept. No other change.
###2026.11.02
- Redesigned Batch Update tab: status strip (updates available, selected, last check, updater state), views for updates available / all / running, and a filter by name or image
- Shift-click selects a range; the confirmation step shows the run order and lets you reorder it by dragging or with arrows
- Live progress per container while the run executes (queued, updating, updated, not updated) and a summary when it finishes
- Shows when an update was started from the Containers tab instead of failing later
- Colours follow the Unraid theme (7.2+ theme variables, 7.0 fallbacks); works on narrow screens
- All strings translatable; attribute-safe escaping; clearer error when the container list cannot be loaded
###2026.10.06
- Initial release
- New "Batch Update" tab on the Docker page
- Select any number of containers with a pending update and update them one after another
</CHANGES>

<!-- Package (cached on the flash drive so it reinstalls offline at boot) -->
<FILE Name="&plgPATH;/&pkgName;.txz" Run="upgradepkg --install-new">
<URL>&gitURL;/archive/&pkgName;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<!-- Post install: drop older cached packages -->
<FILE Run="/bin/bash">
<INLINE>
find "&plgPATH;" -maxdepth 1 -name "&name;-*.txz" ! -name "&pkgName;.txz" -delete
echo ""
echo "----------------------------------------------------"
echo " &name; has been installed."
echo " Version: &version;"
echo " Open Docker > Batch Update to use it."
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- Remove -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
removepkg "&pkgName;"
rm -rf "&emhttp;" "&plgPATH;"
echo "&name; has been removed."
</INLINE>
</FILE>

</PLUGIN>
